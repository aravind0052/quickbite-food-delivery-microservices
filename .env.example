# ============================================================
# QuickBite Central Environment Configuration Template
# Copy this to .env in each respective service / root as required
# ============================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quickbite_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# API Gateway Configuration (:4000)
GATEWAY_PORT=4000
JWT_SECRET=quickbite_super_secret_jwt_key_2026_academic
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Microservice Target URLs (Used by API Gateway)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
RESTAURANT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004

# Service Ports
AUTH_PORT=3001
USER_PORT=3002
RESTAURANT_PORT=3003
ORDER_PORT=3004

# Auth Service Settings
JWT_EXPIRES_IN=7d

# Frontend Configuration (:5173)
VITE_API_URL=http://localhost:4000
